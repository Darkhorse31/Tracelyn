[
  {
    "name": "SSH aliases with inherited defaults and a jump host",
    "kind": "ssh",
    "input": "Host api api-copy\n HostName=api.example.com\n User deploy\n Port 2222\n IdentityFile \"~/.ssh/my key\" # note\nHost * !api-copy\n ProxyJump gateway\nHost *\n User fallback\n",
    "servers": [
      {
        "name": "api",
        "host": "api.example.com",
        "port": 2222,
        "username": "deploy",
        "authType": "key",
        "keyPath": "/home/me/.ssh/my key",
        "labels": [],
        "proxyJump": "gateway",
        "issues": [
          "ProxyJump is not supported yet. Use a directly reachable host"
        ]
      },
      {
        "name": "api-copy",
        "host": "api.example.com",
        "port": 2222,
        "username": "deploy",
        "authType": "key",
        "keyPath": "/home/me/.ssh/my key",
        "labels": [],
        "proxyJump": null,
        "issues": []
      }
    ]
  },
  {
    "name": "Case insensitive keywords and default SSH user",
    "kind": "ssh",
