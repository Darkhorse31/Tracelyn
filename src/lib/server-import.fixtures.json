    "servers": [
      {
        "name": "alpha",
        "host": "alpha.example.com",
        "port": 22,
        "username": "me",
        "authType": "key",
        "keyPath": "/home/me/.ssh/me-alpha.example.com-22",
        "labels": [],
        "proxyJump": null,
        "issues": []
      }
    ]
  },
  {
